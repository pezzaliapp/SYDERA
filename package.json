{
  "name": "sydera",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "description": "SYDERA — local-first Progressive Web App for personal symbolic analysis (Western astrology and Pythagorean numerology).",
  "author": "Alessandro Pezzali",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "fixtures:fetch": "node scripts/fetch-reference-fixtures.mjs",
    "places:build": "node scripts/build-place-dataset.mjs"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
